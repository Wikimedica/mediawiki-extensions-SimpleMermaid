{
	"name": "SimpleMermaid",
	"version": "0.1.2",
	"author": "jmnote",
	"description": "Render Mermaid diagrams from <mermaid> tags using a CDN-hosted Mermaid bundle.",
	"license-name": "Apache-2.0",
	"type": "parserhook",
	"requires": {
		"MediaWiki": ">= 1.39"
	},
	"AutoloadNamespaces": {
		"SimpleMermaid\\": "src/"
	},
	"MessagesDirs": {
		"SimpleMermaid": [
			"i18n"
		]
	},
	"Hooks": {
		"ParserFirstCallInit": "SimpleMermaid\\Hooks::onParserFirstCallInit",
		"OutputPageParserOutput": "SimpleMermaid\\Hooks::onOutputPageParserOutput"
	},
	"ResourceModules": {
		"ext.simpleMermaid": {
			"packageFiles": [
				"resources/ext.simpleMermaid.js",
				{
					"name": "resources/icons.json",
					"callback": "MediaWiki\\ResourceLoader\\CodexModule::getIcons",
					"callbackParam": [
						"cdxIconAdd",
						"cdxIconCheck",
						"cdxIconCollapse",
						"cdxIconCopy",
						"cdxIconExitFullscreen",
						"cdxIconExpand",
						"cdxIconFullscreen",
						"cdxIconNext",
						"cdxIconPrevious",
						"cdxIconReload",
						"cdxIconSubtract"
					]
				}
			],
			"styles": [
				"resources/ext.simpleMermaid.less"
			],
			"messages": [
				"simplemermaid-button-fullscreen",
				"simplemermaid-button-fullscreen-exit",
				"simplemermaid-button-copy",
				"simplemermaid-button-copied",
				"simplemermaid-button-zoom-in",
				"simplemermaid-button-zoom-out",
				"simplemermaid-button-pan-up",
				"simplemermaid-button-pan-down",
				"simplemermaid-button-pan-left",
				"simplemermaid-button-pan-right",
				"simplemermaid-button-reset"
			],
			"targets": [
				"desktop",
				"mobile"
			]
		},
		"ext.simpleMermaid.visualEditor": {
			"scripts": [
				"resources/ve/ve.dm.MWMermaidNode.js",
				"resources/ve/ve.ce.MWMermaidNode.js",
				"resources/ve/ve.ui.MWMermaidInspector.js",
				"resources/ve/ve.simpleMermaid.surface.js"
			],
			"messages": [
				"simplemermaid-ve-empty",
				"simplemermaid-ve-inspector-title"
			],
			"dependencies": [
				"ext.visualEditor.mwcore",
				"ext.visualEditor.mwextensions",
				"ext.simpleMermaid"
			],
			"targets": [
				"desktop",
				"mobile"
			]
		}
	},
	"attributes": {
		"VisualEditor": {
			"PluginModules": [
				"ext.simpleMermaid.visualEditor"
			]
		}
	},
	"ParsoidModules": [
		"SimpleMermaid\\MermaidParsoidModule"
	],
	"ResourceFileModulePaths": {
		"localBasePath": "",
		"remoteExtPath": "SimpleMermaid"
	},
	"manifest_version": 2
}
